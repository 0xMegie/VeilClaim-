// VeilClaim — private provider-attested claim -> Midnight proof -> replay-safe public receipt.
//
// Proof statement:
//   I know a claim credential authenticated by a provider recognized by the contract.
//   The hidden category, service date, and amount satisfy the referenced policy.
//   I know the holder binding required to exercise this claim.
//   The action-scoped claim nullifier is unused. Consume it and record one accepted claim.

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ───────────────────────────── Public types ─────────────────────────────

export struct Policy {
  active: Boolean,
  validFromEpoch: Uint<32>,
  validUntilEpoch: Uint<32>,
  coveredCategory: Uint<16>,
  maxAmount: Uint<64>
}

export struct Provider {
  // Jubjub public key the provider signs claim credentials with.
  attestationKey: JubjubPoint,
  approved: Boolean
}

// Deliberately minimal: no amount, date, category, provider, or holder data.
export struct ClaimReceipt {
  policyId: Bytes<32>,
  claimNullifier: Bytes<32>
}

// ───────────────────────────── Private types ────────────────────────────
// Only ever supplied through witnesses. Never written to the ledger.

export struct ClaimCredential {
  // H(DOMAIN_HOLDER, holderSecret). The provider signs this, never the secret itself.
  holderCommitment: Bytes<32>,
  providerId: Bytes<32>,
  // The provider attests which policy the claim is for, so one claim cannot be consumed under two policies.
  policyId: Bytes<32>,
  categoryCode: Uint<16>,
  serviceEpoch: Uint<32>,
  billedAmount: Uint<64>,
  claimNonce: Bytes<32>
}

// Schnorr signature over Jubjub by the provider's attestationKey:
//   s·G == r + e·attestationKey,  e = attestationChallenge(r, attestationKey, credentialCommitment)
export struct ProviderAttestation {
  r: JubjubPoint,
  s: Field
}

// ───────────────────────────── Public ledger ────────────────────────────

export ledger adminCommitment: Bytes<32>;
export ledger policies: Map<Bytes<32>, Policy>;
export ledger providers: Map<Bytes<32>, Provider>;
export ledger consumedClaimNullifiers: Set<Bytes<32>>;
export ledger claimReceipts: Map<Uint<64>, ClaimReceipt>;
export ledger acceptedClaimCount: Counter;

// ───────────────────────────── Witnesses ────────────────────────────────

witness adminSecret(): Bytes<32>;
witness holderSecret(): Bytes<32>;
witness claimCredential(): ClaimCredential;
witness providerAttestation(): ProviderAttestation;

// ───────────────────────────── Constructor ──────────────────────────────

constructor(initialAdminCommitment: Bytes<32>) {
  adminCommitment = disclose(initialAdminCommitment);
}

// ───────────────────────────── Pure helpers ─────────────────────────────
// Exported so TypeScript derives byte-identical values via pureCircuits.

export circuit deriveAdminCommitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilclaim:admin:v1"), secret]);
}

export circuit deriveHolderCommitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "veilclaim:holder:v1"), secret]);
}

export circuit deriveCredentialCommitment(credential: ClaimCredential): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "veilclaim:credential:v1"),
    persistentHash<ClaimCredential>(credential)
  ]);
}

// Scalars must be below the Jubjub subgroup order (~2^252) or ecMul rejects them. Keeping 31 bytes of the digest
// gives a 248-bit challenge that always fits, so a forged attestation fails the equation instead of the decoder.
export circuit attestationChallenge(r: JubjubPoint, attestationKey: JubjubPoint, credentialCommitment: Bytes<32>): Field {
  const digest = persistentHash<Vector<6, Field>>([
    degradeToTransient(pad(32, "veilclaim:attestation:v1")),
    jubjubPointX(r),
    jubjubPointY(r),
    jubjubPointX(attestationKey),
    jubjubPointY(attestationKey),
    degradeToTransient(credentialCommitment)
  ]);
  return slice<31>(digest, 0) as Field;
}

circuit attestationValid(attestationKey: JubjubPoint, credentialCommitment: Bytes<32>, attestation: ProviderAttestation): Boolean {
  const e = attestationChallenge(attestation.r, attestationKey, credentialCommitment);
  return ecMulGenerator(attestation.s) == ecAdd(attestation.r, ecMul(attestationKey, e));
}

// Deterministic per underlying claim: a new session, proof, or re-signed attestation maps to the same value.
// Mixing in the holder secret stops the provider, who knows every credential, from recognizing receipts on-chain.
circuit deriveClaimNullifier(credential: ClaimCredential, credentialCommitment: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  const claimBinding = persistentHash<Vector<4, Bytes<32>>>([
    credential.providerId,
    credential.policyId,
    credential.claimNonce,
    credentialCommitment
  ]);
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "veilclaim:claim:v1"),
    kernel.self().bytes,
    credential.policyId,
    claimBinding,
    secret
  ]);
}

// Authorization is proof of knowledge of the admin secret, not ownPublicKey().
circuit assertAdmin(): [] {
  assert(deriveAdminCommitment(adminSecret()) == adminCommitment, "VeilClaim: not admin");
}

// ───────────────────────────── Circuits ─────────────────────────────────

export circuit createPolicy(
  policyId: Bytes<32>,
  validFromEpoch: Uint<32>,
  validUntilEpoch: Uint<32>,
  coveredCategory: Uint<16>,
  maxAmount: Uint<64>
): [] {
  assertAdmin();

  const id = disclose(policyId);
  const fromEpoch = disclose(validFromEpoch);
  const untilEpoch = disclose(validUntilEpoch);
  const cap = disclose(maxAmount);

  assert(!policies.member(id), "VeilClaim: policy exists");
  assert(fromEpoch <= untilEpoch, "VeilClaim: invalid policy interval");
  assert(cap > 0, "VeilClaim: invalid cap");

  policies.insert(id, Policy {
    active: true,
    validFromEpoch: fromEpoch,
    validUntilEpoch: untilEpoch,
    coveredCategory: disclose(coveredCategory),
    maxAmount: cap
  });
}

export circuit deactivatePolicy(policyId: Bytes<32>): [] {
  assertAdmin();
  const id = disclose(policyId);
  assert(policies.member(id), "VeilClaim: unknown policy");
  const policy = policies.lookup(id);
  policies.insert(id, Policy {
    active: false,
    validFromEpoch: policy.validFromEpoch,
    validUntilEpoch: policy.validUntilEpoch,
    coveredCategory: policy.coveredCategory,
    maxAmount: policy.maxAmount
  });
}

export circuit setProviderStatus(
  providerId: Bytes<32>,
  attestationKey: JubjubPoint,
  approved: Boolean
): [] {
  assertAdmin();
  providers.insert(disclose(providerId), Provider {
    attestationKey: disclose(attestationKey),
    approved: disclose(approved)
  });
}

// Every check discloses only its boolean outcome, never the private values compared.
// All writes happen after every check, in one transaction: nullifier, receipt, and count land together or not at all.
export circuit submitClaim(policyId: Bytes<32>): [] {
  const id = disclose(policyId);
  assert(policies.member(id), "VeilClaim: unknown policy");
  const policy = policies.lookup(id);
  assert(policy.active, "VeilClaim: policy inactive");

  const credential = claimCredential();
  const secret = holderSecret();
  const attestation = providerAttestation();

  assert(disclose(credential.policyId == id), "VeilClaim: credential is for another policy");

  // The provider id is disclosed to look up its key: which approved provider attested is visible on-chain.
  const providerId = disclose(credential.providerId);
  assert(providers.member(providerId), "VeilClaim: unknown provider");
  const provider = providers.lookup(providerId);
  assert(provider.approved, "VeilClaim: provider not approved");

  const credentialCommitment = deriveCredentialCommitment(credential);
  assert(disclose(attestationValid(provider.attestationKey, credentialCommitment, attestation)),
    "VeilClaim: invalid provider attestation");
  assert(disclose(deriveHolderCommitment(secret) == credential.holderCommitment), "VeilClaim: holder binding failed");

  assert(disclose(credential.categoryCode == policy.coveredCategory), "VeilClaim: category not covered");
  assert(disclose(credential.serviceEpoch >= policy.validFromEpoch), "VeilClaim: service date outside policy window");
  assert(disclose(credential.serviceEpoch <= policy.validUntilEpoch), "VeilClaim: service date outside policy window");
  assert(disclose(credential.billedAmount <= policy.maxAmount), "VeilClaim: amount exceeds policy cap");

  const claimNullifier = disclose(deriveClaimNullifier(credential, credentialCommitment, secret));
  assert(!consumedClaimNullifiers.member(claimNullifier), "VeilClaim: claim already consumed");

  const receiptIndex = acceptedClaimCount.read();
  consumedClaimNullifiers.insert(claimNullifier);
  claimReceipts.insert(receiptIndex, ClaimReceipt { policyId: id, claimNullifier: claimNullifier });
  acceptedClaimCount.increment(1);
}
